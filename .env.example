LITELLM_PROVIDER=anthropic
LITELLM_MODEL_NAME=claude-opus-4-6
API_BASE=
API_KEY=
HARNESS_REASONING_EFFORT=medium
HARNESS_MODEL_RETRIES=5
# Stream model responses so upstream proxies (Cloudflare 120s read timeout -> HTTP 524)
# do not kill long requests. 0 disables streaming and restores non-streaming calls.
HARNESS_STREAM=1
# Client-side read timeout for one request, in seconds. This cannot extend the
# timeout enforced by an upstream reverse proxy such as Cloudflare.
HARNESS_REQUEST_TIMEOUT_SECONDS=9999
HARNESS_SYSTEM_REINJECTION_INTERVAL=20
HARNESS_MAX_TOKENS=99999
HARNESS_MAX_ITERATIONS=99999
HARNESS_TEMPERATURE=1
HARNESS_ARTIFACTS_DIR=artifacts
HARNESS_CONTEXT_COMPACTION_THRESHOLD_CHARS=500000